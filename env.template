# auto_invest — environment template
# Copy to .env locally and fill in your credentials. The .env file is gitignored.
# In cloud routines, set these as environment variables on the routine config — DO NOT create a .env file in the cloud.

# --- Alpaca ---------------------------------------------------------
# Paper account: get keys from https://alpaca.markets/ (paper dashboard)
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here

# --- Mode (v3.4) ----------------------------------------------------
# TRADING_MODE selects WHICH account every routine acts on: "paper" or "live".
# Unset defaults to "paper". Nothing infers it from the endpoint, and nothing
# infers the endpoint from it — every routine's mode guard halts on a mismatch,
# which is the whole point: it catches a half-done switch.
#
# Going live means changing TRADING_MODE *and* ALPACA_ENDPOINT together, plus
# live keys. Do not do it on any cloud routine while the paper trial is running
# (see docs/LIVE-SMOKE-TEST.md — the live smoke test is a one-off, local,
# manual procedure with its own env exports, never the cloud UI).
TRADING_MODE=paper

# Endpoint MUST be set explicitly. No defaulting to the live URL.
# Paper: https://paper-api.alpaca.markets/v2   <- pairs with TRADING_MODE=paper
# Live:  https://api.alpaca.markets/v2         <- pairs with TRADING_MODE=live
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2

# Data endpoint is the same for paper and live.
ALPACA_DATA_ENDPOINT=https://data.alpaca.markets/v2

# --- Perplexity (research) ----------------------------------------
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar

# --- Telegram (notifications via Bot API) -------------------------
# 1. Open Telegram, chat with @BotFather -> /newbot -> follow prompts.
#    Save the token it gives you (looks like 123456789:ABC...).
# 2. Search for your new bot, send it /start so it can DM you.
# 3. Get your chat ID by visiting (replace <TOKEN>):
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    Find "chat":{"id":NNNNN,...} in the JSON. That number is TELEGRAM_CHAT_ID.
# Both vars must be set for notifications to fire; otherwise wrapper falls
# back to writing DAILY-SUMMARY.md (gitignored) and exits 0.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Kill switch --------------------------------------------------
# Gates every state-changing Alpaca subcommand in scripts/alpaca.sh (order,
# close, scale-out, trailing-stop, replace-stop, cancel...). "false" makes the
# wrapper refuse with exit 4; read-only subcommands still work.
#
# The cloud routines have run with "true" since v2 — that is the live setting
# for the paper account, and v3/v3.4 assume it. This template ships "false" so a
# fresh local copy cannot place an order by accident: flip it to "true"
# deliberately when you actually want /trade, /market-open or the live smoke
# test to transmit orders, and remember that "true" + TRADING_MODE=live is real
# money.
TRADING_ENABLED=false
